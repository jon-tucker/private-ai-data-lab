pid /tmp/nginx.pid;

events {}

http {
  access_log /dev/stdout;
  error_log /dev/stderr info;

  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  server {
    listen 8443 ssl;
    server_name __SERVER_NAME__ __HOST_BIND__;

    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    allow 127.0.0.1;
    allow __ALLOWED_CIDR__;
    deny all;

    location / {
      proxy_pass https://__UPSTREAM_IP__:__UPSTREAM_PORT__;

      proxy_ssl_verify on;
      proxy_ssl_verify_depth 1;
      proxy_ssl_trusted_certificate /etc/nginx/upstream/upstream.crt;
      proxy_ssl_name agent-factory;

      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Port __EDGE_PORT__;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;

      proxy_buffering off;
      proxy_request_buffering off;
      proxy_read_timeout 660s;
      proxy_send_timeout 660s;
    }
  }
}
