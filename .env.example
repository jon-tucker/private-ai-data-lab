# Oracle AI Data Platform
# Copy this file to .env and replace example values locally.
# Never commit real passwords, API keys, wallets, or private credentials.

COMPOSE_PROJECT_NAME=oracle-ai-data-platform

# Host paths
PLATFORM_DATA_ROOT=/srv/oracle-ai-data
PLATFORM_SECRETS_ROOT=/srv/oracle-ai-secrets

# Host identity
PLATFORM_HOSTNAME=oracle-ai
PLATFORM_HOST_IP=192.168.0.209
TZ=America/Chicago

# Shared networks
FRONTEND_NETWORK=oracle-ai-frontend
BACKEND_NETWORK=oracle-ai-backend

# Oracle AI Database 26ai Free
ORACLE_DATABASE_IMAGE=container-registry.oracle.com/database/free:23.26.2.0
ORACLE_DATABASE_CONTAINER=oracle-ai-database
ORACLE_DATABASE_HOST_BIND=0.0.0.0
ORACLE_DATABASE_PORT=1521
ORACLE_DATABASE_CPUS=4.0
ORACLE_DATABASE_MEMORY=8g
ORACLE_DATABASE_SHM_SIZE=2g
ORACLE_PDB=FREEPDB1
ORACLE_CHARACTERSET=AL32UTF8
ORACLE_PASSWORD_FILE=/srv/oracle-ai-secrets/oracle-db-password
ORACLE_ENABLE_ARCHIVELOG=true
ORACLE_ENABLE_FORCE_LOGGING=true

# Ollama
OLLAMA_ACCELERATOR=rocm
OLLAMA_ROCM_IMAGE=ollama/ollama:0.32.0-rocm
OLLAMA_CPU_IMAGE=ollama/ollama:0.32.0
OLLAMA_CONTAINER=oracle-ai-ollama
OLLAMA_HOST_BIND=127.0.0.1
OLLAMA_IGPU_ENABLE=1
OLLAMA_PORT=11434
OLLAMA_CPUS=8.0
OLLAMA_MEMORY=12g
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=10m
OLLAMA_DEFAULT_MODEL=qwen3:4b-instruct

# AI services
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.10.2
OPEN_WEBUI_CONTAINER=oracle-ai-open-webui
OPEN_WEBUI_HOST_BIND=0.0.0.0
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_CPUS=4.0
OPEN_WEBUI_MEMORY=4g
OPEN_WEBUI_SECRET_FILE=/srv/oracle-ai-secrets/open-webui-secret-key
OPEN_WEBUI_URL=http://192.168.0.209:3000
OPEN_WEBUI_ENABLE_SIGNUP=true
OPEN_WEBUI_DEFAULT_MODEL=qwen3:4b-instruct

# Private LiteLLM model gateway
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.92.0
LITELLM_CONTAINER=oracle-ai-litellm
LITELLM_HOST_BIND=192.168.122.1
LITELLM_PORT=4000
LITELLM_CPUS=2.0
LITELLM_MEMORY=2g
LITELLM_CONFIG=/srv/oracle-ai-data/litellm/config.yaml
LITELLM_MASTER_KEY_FILE=/srv/oracle-ai-secrets/litellm-master-key
LITELLM_MODEL_ALIAS=local-qwen3-4b-instruct
LITELLM_OLLAMA_MODEL=qwen3:4b-instruct
LITELLM_OLLAMA_URL=http://ollama:11434
LITELLM_TLS_IMAGE=nginx:1.30.4-alpine3.24
LITELLM_TLS_CONTAINER=oracle-ai-litellm-tls
LITELLM_TLS_DIR=/srv/oracle-ai-secrets/litellm-tls
LITELLM_NGINX_CONFIG=/srv/oracle-ai-data/litellm/nginx.conf
LITELLM_HTTPS_HOST_BIND=192.168.122.1
LITELLM_HTTPS_PORT=4001

# Private Agent Factory browser edge
AGENT_FACTORY_EDGE_IMAGE=nginx:1.30.4-alpine3.24
AGENT_FACTORY_EDGE_CONTAINER=oracle-ai-agent-factory-edge
AGENT_FACTORY_EDGE_TLS_DIR=/srv/oracle-ai-secrets/agent-factory-edge-tls
AGENT_FACTORY_EDGE_DATA_DIR=/srv/oracle-ai-data/agent-factory-edge
AGENT_FACTORY_EDGE_HOST_BIND=192.168.0.209
AGENT_FACTORY_EDGE_PORT=443
AGENT_FACTORY_EDGE_ALLOWED_CIDR=192.168.0.0/24
AGENT_FACTORY_EDGE_SERVER_NAME=oracle-ai.local

# Oracle REST Data Services 26.2
ORDS_IMAGE=container-registry.oracle.com/database/ords:26.2.0
ORDS_CONTAINER=oracle-ai-ords
ORDS_INSTALL_CONTAINER=oracle-ai-ords-install
ORDS_HOST_BIND=0.0.0.0
ORDS_PORT=8080
ORDS_CPUS=2.0
ORDS_MEMORY=2g
ORDS_CONFIG_DIR=/srv/oracle-ai-data/ords
ORDS_PUBLIC_PASSWORD_FILE=/srv/oracle-ai-secrets/ords-public-user-password
ORDS_URL=http://192.168.0.209:8080/ords/

# Oracle APEX 26.1
APEX_VERSION=26.1
APEX_SOURCE_DIR=/srv/oracle-ai-work/apex/apex
APEX_IMAGES_DIR=/srv/oracle-ai-data/apex/images
APEX_CONTAINER_SOURCE_DIR=/opt/oracle/apex-26.1
APEX_TABLESPACE=APEX
APEX_FILES_TABLESPACE=APEX_FILES
APEX_ADMIN_USERNAME=ADMIN
APEX_URL=http://192.168.0.209:8080/ords/

# Oracle SQLcl MCP Server 26.2
MCP_SQLCL_IMAGE=container-registry.oracle.com/database/sqlcl:26.2.0
MCP_SQLCL_HOME=/srv/oracle-ai-data/mcp/sqlcl-home
MCP_DATABASE_PASSWORD_FILE=/srv/oracle-ai-secrets/mcp-database-password
MCP_DATABASE_USER=ORACLE_AI_MCP
MCP_DATABASE_ROLE=ORACLE_AI_MCP_READ_ROLE
MCP_CONNECTION_NAME=oracle_ai_readonly
MCP_SOURCE_SCHEMA=ORACLE_AI
MCP_RESTRICT_LEVEL=4
MCP_UID=54321
MCP_GID=54321
MCP_HTTP_IMAGE=oracle-ai/sqlcl-mcp-http:26.2.0
MCP_HTTP_CONTAINER=oracle-ai-sqlcl-mcp-http
MCP_NODEJS_STREAM=22
MCP_SUPERGATEWAY_VERSION=3.4.3
MCP_HTTP_SESSION_TIMEOUT_MS=600000
MCP_TLS_IMAGE=nginx:1.30.4-alpine3.24
MCP_TLS_CONTAINER=oracle-ai-sqlcl-mcp-tls
MCP_TLS_DIR=/srv/oracle-ai-secrets/mcp-tls
MCP_NGINX_CONFIG=/srv/oracle-ai-data/mcp/nginx.conf
MCP_HTTPS_HOST_BIND=192.168.122.1
MCP_HTTPS_PORT=8182
PLATFORM_UID=1000
PLATFORM_GID=1000

# Oracle AI Database Private Agent Factory 26.4
AGENT_FACTORY_VERSION=26.4.0
AGENT_FACTORY_VM_NAME=agent-factory
AGENT_FACTORY_VM_IP=192.168.122.202
AGENT_FACTORY_VM_USER=jon
AGENT_FACTORY_VM_URI=qemu:///system
AGENT_FACTORY_OS_DISK=/srv/oracle-ai-data/vms/agent-factory-ol8.qcow2
AGENT_FACTORY_BUILD_DISK=/srv/oracle-ai-data/vms/agent-factory-build.qcow2
AGENT_FACTORY_DB_USER=AGENT_FACTORY
AGENT_FACTORY_DB_READ_USER=AAI_RO_AGENT_FACTORY
AGENT_FACTORY_DB_PASSWORD_FILE=/srv/oracle-ai-secrets/agent-factory-db-password
AGENT_FACTORY_OLLAMA_URL=http://192.168.122.1:11434
AGENT_FACTORY_LITELLM_URL=http://192.168.122.1:4000/v1
AGENT_FACTORY_LITELLM_HTTPS_URL=https://192.168.122.1:4001/v1
AGENT_FACTORY_STAGE_ROOT=/u01/agent-factory
AGENT_FACTORY_INSTALL_DIR=/u01/agent-factory/staging/26.4.0-initial
AGENT_FACTORY_PORT=8080

# Agent operations and recovery
AGENT_OPERATIONS_BACKUP_ROOT=/srv/oracle-ai-data/backups/agent-operations
AGENT_OPERATIONS_CERT_WARN_DAYS=90
AGENT_OPERATIONS_DISK_WARN_PERCENT=80
AGENT_OPERATIONS_VM_SHUTDOWN_TIMEOUT=300
BACKUP_LIFECYCLE_RETENTION_DAYS=30
BACKUP_LIFECYCLE_MINIMUM_SETS=2
BACKUP_LIFECYCLE_RESERVE_PERCENT=15
BACKUP_LIFECYCLE_DRILL_ROOT=/srv/oracle-ai-data/restore-drills

# Scheduled observability
OBSERVABILITY_HEALTH_CALENDAR="*-*-* 06:15:00 UTC"
OBSERVABILITY_HEALTH_RANDOM_DELAY=15m
OBSERVABILITY_BACKUP_CALENDAR="Sun *-*-* 04:00:00 UTC"
OBSERVABILITY_BACKUP_RANDOM_DELAY=30m
OBSERVABILITY_WEBHOOK_URL_FILE=/srv/oracle-ai-secrets/observability-webhook-url
OPERATIONS_AGENT_ENABLED=1
OPERATIONS_AGENT_RETENTION_DAYS=365

# LiveStack application integration (application only; existing database and Ollama)
LIVESTACK_IMAGE=oracle-ai/livestack-utilities:1.2.0
LIVESTACK_CONTAINER=oracle-ai-livestack
LIVESTACK_SOURCE_DIR=/srv/oracle-ai-work/livestack/utilities
LIVESTACK_ARCHIVE=/tmp/livestack.zip
LIVESTACK_HOST_BIND=127.0.0.1
LIVESTACK_PORT=8505
LIVESTACK_DATABASE_USER=LIVESTACK
LIVESTACK_DATABASE_PASSWORD_FILE=/srv/oracle-ai-secrets/livestack-database-password
LIVESTACK_DATABASE_CONNECT_STRING=oracle-db:1521/FREEPDB1
LIVESTACK_OLLAMA_URL=http://ollama:11434
LIVESTACK_OLLAMA_MODEL=qwen3:4b-instruct
LIVESTACK_TELEMETRY_ENABLED=false
