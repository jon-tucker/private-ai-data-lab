# Oracle AI Data Platform v0.3.0
# Copy this file to .env and replace example values locally.
# Never commit real passwords, API keys, wallets, or private credentials.

COMPOSE_PROJECT_NAME=oracle-ai-data-platform

# Host paths
PLATFORM_DATA_ROOT=/srv/oracle-ai-data
PLATFORM_SECRETS_ROOT=/srv/oracle-ai-secrets

# Host identity
PLATFORM_HOSTNAME=oracle-ai
PLATFORM_HOST_IP=192.168.0.209
TZ=America/Chicago

# Shared networks
FRONTEND_NETWORK=oracle-ai-frontend
BACKEND_NETWORK=oracle-ai-backend

# Oracle AI Database 26ai Free
ORACLE_DATABASE_IMAGE=container-registry.oracle.com/database/free:23.26.2.0
ORACLE_DATABASE_CONTAINER=oracle-ai-database
ORACLE_DATABASE_HOST_BIND=0.0.0.0
ORACLE_DATABASE_PORT=1521
ORACLE_DATABASE_CPUS=4.0
ORACLE_DATABASE_MEMORY=8g
ORACLE_DATABASE_SHM_SIZE=2g
ORACLE_PDB=FREEPDB1
ORACLE_CHARACTERSET=AL32UTF8
ORACLE_PASSWORD_FILE=/srv/oracle-ai-secrets/oracle-db-password
ORACLE_ENABLE_ARCHIVELOG=true
ORACLE_ENABLE_FORCE_LOGGING=true

# Ollama
OLLAMA_ACCELERATOR=rocm
OLLAMA_ROCM_IMAGE=ollama/ollama:0.32.0-rocm
OLLAMA_CPU_IMAGE=ollama/ollama:0.32.0
OLLAMA_CONTAINER=oracle-ai-ollama
OLLAMA_HOST_BIND=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_CPUS=8.0
OLLAMA_MEMORY=12g
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=10m
OLLAMA_DEFAULT_MODEL=qwen3:4b

# AI services reserved for later releases
OPEN_WEBUI_PORT=3000
LITELLM_PORT=4000

# Oracle application services (reserved for later releases)
ORDS_PORT=8080
MCP_PORT=8001
AGENT_FACTORY_PORT=8002
